{
  "name": "zimu-studio",
  "version": "0.1.0",
  "private": true,
  "description": "字幕工坊 - 本地 AI 日英双语字幕工作台",
  "main": "./out/main/index.js",
  "author": "Zimu Studio",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:queue-electron": "node scripts/smoke-queue.cjs",
    "prepare:ffmpeg": "node scripts/fetch-sidecars.mjs --ffmpeg-only",
    "prepare:whisper": "node scripts/fetch-sidecars.mjs --whisper-only",
    "prepare:sidecars": "node scripts/fetch-sidecars.mjs",
    "verify:sidecars": "node scripts/verify-sidecars.mjs",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist": "npm run build && npm run verify:sidecars && electron-builder --win nsis"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "studio.zimu.desktop",
    "productName": "字幕工坊",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Zimu-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
